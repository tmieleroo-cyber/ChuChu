@manejo_errores(timeout=120, reintentos=2)
def trigger_vss_snapshot(timeout: int = TIMEOUT_DEFECTO) -> dict:
    """Crea snapshot de Volume Shadow Copy en C:"""
    resultado = ejecutar_cmd(["vssadmin"], timeout=10)
    if resultado["returncode"] != 0:
        raise RuntimeError("vssadmin no disponible")
    
    resultado = ejecutar_cmd(
        ["vssadmin", "create", "shadow", "/for=C:"],
        timeout=timeout
    )
    
    if resultado["returncode"] != 0:
        raise subprocess.CalledProcessError(
            resultado["returncode"],
            "vssadmin",
            resultado["stderr"]
        )
    
    return resultado


