def detectar_entorno_virtualizacion():
    """Detecta si estamos en VirtualBox o WSL"""
    try:
        resultado = subprocess.run(
            ["systeminfo"],
            capture_output=True,
            text=True,
            timeout=5
        )
        if "VirtualBox" in resultado.stdout or "VBox" in resultado.stdout:
            return "virtualbox"
        elif "Microsoft" in resultado.stdout or "WSL" in resultado.stdout:
            return "wsl"
    except:
        pass
    return "native"

