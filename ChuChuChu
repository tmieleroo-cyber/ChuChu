def es_administrador() -> bool:
    """Verifica si el script se ejecuta con permisos de administrador"""
    try:
        if ENTORNO == "virtualbox":
            resultado = subprocess.run(
                ["powershell", "-NoProfile", "-Command", 
                 "[Security.Principal.WindowsIdentity]::GetCurrent().Owner.Value -match 'S-1-5-32-544'"],
                capture_output=True,
                text=True,
                timeout=5
            )
            return "True" in resultado.stdout or resultado.returncode == 0
        else:
            try:
                return ctypes.windll.shell.IsUserAnAdmin()
            except:
                resultado = subprocess.run(
                    ["powershell", "-NoProfile", "-Command", 
                     "[Security.Principal.WindowsIdentity]::GetCurrent().Owner.Value -match 'S-1-5-32-544'"],
                    capture_output=True,
                    text=True,
                    timeout=5
                )
                return "True" in resultado.stdout or resultado.returncode == 0
    except Exception as e:
        logger.debug(f"Admin check failed: {e}")
        return False


def validar_permisos() -> bool:
    """Valida y obtiene permisos sin UAC si es posible"""
    if es_administrador():
        logger.info("[+] Script ejecutandose con permisos de administrador")
        return True
    
    logger.warning("[!] Se requieren permisos de administrador")
    
    if sys.platform == "win32":
        return obtener_admin_sin_uac()
    
    return False


