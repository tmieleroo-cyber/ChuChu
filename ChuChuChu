    LOG_DIR = Path(os.environ.get("PROGRAMDATA", "C:\\ProgramData")) / "tejon_logs"
else:
    LOG_DIR = Path(tempfile.gettempdir()) / "tejon_logs"

LOG_DIR.mkdir(exist_ok=True, parents=True)

